{
  "name": "hide-n-seat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verifyEngine.ts && tsx scripts/verifyRounds.ts && tsx scripts/verifyDesign.ts",
    "verify:engine": "tsx scripts/verifyEngine.ts",
    "verify:rounds": "tsx scripts/verifyRounds.ts",
    "verify:design": "tsx scripts/verifyDesign.ts"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs": "4.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
